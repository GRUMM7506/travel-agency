DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel_agency_db

# ОБЯЗАТЕЛЬНО замените: этим ключом подписываются JWT сотрудников и клиентов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

CORS_ORIGINS=["*"]

# Агентская комиссия по умолчанию — для заявок, которые клиент оформляет сам
DEFAULT_COMMISSION_PERCENT=10

# Реквизиты для перевода. Платёжного шлюза в MVP нет: клиент переводит сам,
# жмёт «Я оплатил», сотрудник подтверждает поступление вручную.
PAYMENT_RECIPIENT=ООО «Турагентство Мечта»
PAYMENT_CARD_NUMBER=0000 0000 0000 0000
PAYMENT_BANK_NAME=Название банка
PAYMENT_COMMENT=Обязательно укажите номер бронирования в комментарии к переводу.
